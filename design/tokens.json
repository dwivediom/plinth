{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Apple HIG–inspired design schema for the DB client. Single source of truth — tokens.css mirrors this. See PLAN-3-DESIGN.md.",
  "version": "2.0.0",

  "color": {
    "light": {
      "window":              { "$value": "#ECECEC",                 "$macos": "windowBackgroundColor" },
      "content":             { "$value": "#FFFFFF",                 "$macos": "controlBackgroundColor" },
      "sidebar":             { "$value": "rgba(236,236,236,0.80)",  "$macos": "NSVisualEffectMaterial.sidebar", "blur": "30px" },
      "alt-row":             { "$value": "rgba(0,0,0,0.03)",        "$macos": "alternatingContentBackgroundColors[1]" },
      "control":             { "$value": "#FFFFFF" },
      "popover":             { "$value": "rgba(246,246,246,0.92)",  "$macos": "NSVisualEffectMaterial.popover", "blur": "30px" },
      "separator":           { "$value": "rgba(0,0,0,0.10)",        "$macos": "separatorColor" },
      "grid":                { "$value": "rgba(0,0,0,0.08)",        "$macos": "gridColor" },
      "label":               { "$value": "rgba(0,0,0,0.85)",        "$macos": "labelColor" },
      "label-2":             { "$value": "rgba(0,0,0,0.50)",        "$macos": "secondaryLabelColor" },
      "label-3":             { "$value": "rgba(0,0,0,0.26)",        "$macos": "tertiaryLabelColor" },
      "label-4":             { "$value": "rgba(0,0,0,0.10)",        "$macos": "quaternaryLabelColor" },
      "accent":              { "$value": "#007AFF", "$css": "AccentColor",     "$macos": "controlAccentColor (system)" },
      "accent-text":         { "$value": "#FFFFFF", "$css": "AccentColorText" },
      "selection-unfocused": { "$value": "#DCDCDC",                 "$macos": "unemphasizedSelectedContentBackgroundColor" },
      "green":               { "$value": "#28CD41",                 "$macos": "systemGreen" },
      "orange":              { "$value": "#FF9500",                 "$macos": "systemOrange" },
      "red":                 { "$value": "#FF3B30",                 "$macos": "systemRed" },
      "yellow":              { "$value": "#FFCC00",                 "$macos": "systemYellow" },
      "gray":                { "$value": "#8E8E93",                 "$macos": "systemGray" },
      "shadow-button":       { "$value": "0 0.5px 1px rgba(0,0,0,0.15)" },
      "shadow-float":        { "$value": "0 8px 40px rgba(0,0,0,0.25)" },
      "scrim":               { "$value": "rgba(0,0,0,0.20)" }
    },
    "dark": {
      "window":              { "$value": "#323232" },
      "content":             { "$value": "#1E1E1E" },
      "sidebar":             { "$value": "rgba(40,40,40,0.80)", "blur": "30px" },
      "alt-row":             { "$value": "rgba(255,255,255,0.04)" },
      "control":             { "$value": "rgba(255,255,255,0.10)" },
      "popover":             { "$value": "rgba(46,46,46,0.92)", "blur": "30px" },
      "separator":           { "$value": "rgba(255,255,255,0.10)" },
      "grid":                { "$value": "rgba(255,255,255,0.08)" },
      "label":               { "$value": "rgba(255,255,255,0.85)" },
      "label-2":             { "$value": "rgba(255,255,255,0.55)" },
      "label-3":             { "$value": "rgba(255,255,255,0.25)" },
      "label-4":             { "$value": "rgba(255,255,255,0.10)" },
      "accent":              { "$value": "#0A84FF", "$css": "AccentColor" },
      "accent-text":         { "$value": "#FFFFFF", "$css": "AccentColorText" },
      "selection-unfocused": { "$value": "#464646" },
      "green":               { "$value": "#32D74B" },
      "orange":              { "$value": "#FF9F0A" },
      "red":                 { "$value": "#FF453A" },
      "yellow":              { "$value": "#FFD60A" },
      "gray":                { "$value": "#98989D" },
      "shadow-button":       { "$value": "0 0.5px 1px rgba(0,0,0,0.40)" },
      "shadow-float":        { "$value": "0 8px 40px rgba(0,0,0,0.60)" },
      "scrim":               { "$value": "rgba(0,0,0,0.40)" }
    },
    "semantic": {
      "$description": "The complete list of places colour appears outside labels and backgrounds.",
      "selection-focused":   { "fill": "{color.accent}", "text": "{color.accent-text}" },
      "selection-unfocused": { "fill": "{color.selection-unfocused}", "text": "{color.label}" },
      "focus-ring":          { "$value": "{color.accent}", "opacity": 0.5, "width": "3.5px", "style": "soft glow (box-shadow), not outline" },
      "default-button":      { "fill": "{color.accent}", "text": "{color.accent-text}" },
      "sidebar-icon":        { "$value": "{color.accent}" },
      "null":                { "$value": "{color.label-3}", "style": "italic" },
      "dirty-cell":          { "$value": "{color.yellow}", "opacity": 0.18 },
      "env-production":      { "$value": "{color.red}" },
      "env-staging":         { "$value": "{color.orange}" },
      "env-local":           { "$value": null },
      "tunnel-up":           { "$value": "{color.green}" },
      "tunnel-degraded":     { "$value": "{color.orange}" },
      "tunnel-down":         { "$value": "{color.red}" },
      "syntax-keyword":      { "$value": "{color.accent}" },
      "syntax-string":       { "$value": "{color.red}",    "$note": "Xcode convention" },
      "syntax-number":       { "$value": "{color.accent}", "opacity": 0.8 },
      "syntax-comment":      { "$value": "{color.label-3}" },
      "error-text":          { "$value": "{color.red}" }
    }
  },

  "font": {
    "family": {
      "ui":   { "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif" },
      "mono": { "$value": "ui-monospace, 'SF Mono', Menlo, 'JetBrains Mono', Consolas, monospace" }
    },
    "style": {
      "$description": "macOS text styles. Use by name.",
      "large-title": { "size": "26px", "line": "32px", "weight": 700 },
      "title-1":     { "size": "22px", "line": "26px", "weight": 400 },
      "title-2":     { "size": "17px", "line": "22px", "weight": 400 },
      "title-3":     { "size": "15px", "line": "20px", "weight": 600 },
      "headline":    { "size": "13px", "line": "16px", "weight": 600 },
      "body":        { "size": "13px", "line": "16px", "weight": 400 },
      "callout":     { "size": "12px", "line": "15px", "weight": 400 },
      "subheadline": { "size": "11px", "line": "14px", "weight": 400 },
      "caption":     { "size": "10px", "line": "13px", "weight": 400 },
      "mono":        { "size": "12px", "line": "20px", "weight": 400, "family": "{font.family.mono}" }
    },
    "features": {
      "numeric": { "$value": "tabular-nums", "$description": "Every numeric cell." },
      "letter-spacing": { "$value": "0", "$description": "Never adjusted — SF is optically corrected per size." }
    }
  },

  "space": {
    "1": { "$value": "2px" }, "2": { "$value": "4px" }, "3": { "$value": "6px" }, "4": { "$value": "8px" },
    "5": { "$value": "12px" }, "6": { "$value": "16px" }, "7": { "$value": "20px" }, "8": { "$value": "28px" }
  },

  "radius": {
    "control": { "$value": "6px",   "$description": "Buttons, fields, segmented controls, sidebar selection" },
    "popover": { "$value": "10px",  "$description": "Popovers, menus, palette" },
    "sheet":   { "$value": "12px",  "$description": "Sheets, windows" },
    "pill":    { "$value": "999px" }
  },

  "size": {
    "control":        { "$value": "22px", "$description": "Regular control height" },
    "control-large":  { "$value": "28px" },
    "row-grid":       { "$value": "26px" },
    "row-list":       { "$value": "28px" },
    "row-sidebar":    { "$value": "28px" },
    "titlebar":       { "$value": "52px", "$description": "Unified toolbar height with overlay title bar" },
    "titlebar-plain": { "$value": "38px", "$description": "Windows/Linux toolbar under native title bar" },
    "sidebar":        { "$value": "220px", "min": "180px", "max": "320px" },
    "inspector":      { "$value": "260px" },
    "status-dot":     { "$value": "7px" },
    "env-dot":        { "$value": "3px" },
    "icon":           { "$value": "16px" },
    "icon-stroke":    { "$value": "1.5px" },
    "hairline":       { "$value": "1px", "$retina": "0.5px" },
    "window-min":     { "width": "900px", "height": "560px" }
  },

  "motion": {
    "sheet":     { "duration": "200ms", "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)" },
    "selection": { "duration": "150ms", "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)" },
    "$description": "Sheets slide from the title bar. Popovers fade+scale from 0.98. Nothing animates on launch."
  },

  "platform": {
    "macos":   { "titlebar": "overlay", "vibrancy": "sidebar", "accent": "system", "mono": "SF Mono" },
    "windows": { "titlebar": "native",  "vibrancy": false,     "accent": "#007AFF", "mono": "JetBrains Mono (bundled)" },
    "linux":   { "titlebar": "native",  "vibrancy": false,     "accent": "#007AFF", "mono": "JetBrains Mono (bundled)" }
  },

  "icons": { "set": "lucide", "style": "SF Symbols–like monochrome", "size": "{size.icon}", "stroke": "{size.icon-stroke}" }
}
